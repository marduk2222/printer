@model printer.Data.Entities.EinvoiceAllowance
@{
    ViewData["Title"] = $"折讓 {Model.AllowanceNumber}";
    var statusNames = new Dictionary<string, (string Name, string Class)>
    {
        ["draft"] = ("草稿", "bg-secondary"),
        ["issued"] = ("已開立", "bg-success"),
        ["void"] = ("已作廢", "bg-danger"),
    };
    var status = statusNames.GetValueOrDefault(Model.Status, ("未知", "bg-secondary"));
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>折讓單詳情</h4>
    <a asp-action="Details" asp-route-id="@Model.EinvoiceId" class="btn btn-outline-secondary btn-sm">返回原發票</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="row">
    <div class="col-md-8">
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>折讓資訊</span>
                <span class="badge @status.Item2">@status.Item1</span>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">折讓單號</dt>
                    <dd class="col-sm-9"><strong>@(string.IsNullOrEmpty(Model.AllowanceNumber) ? "（尚未開立）" : Model.AllowanceNumber)</strong></dd>
                    <dt class="col-sm-3">折讓日期</dt>
                    <dd class="col-sm-9">@Model.AllowanceDate.ToString("yyyy/MM/dd")</dd>
                    <dt class="col-sm-3">折讓類型</dt>
                    <dd class="col-sm-9">@(Model.AllowanceType == "online" ? "線上（買方通知）" : "紙本（賣方開立）")</dd>
                    <dt class="col-sm-3">原發票</dt>
                    <dd class="col-sm-9">@Model.Einvoice?.InvoiceNumber — @Model.Einvoice?.Partner?.Name</dd>
                    <dt class="col-sm-3">平台</dt>
                    <dd class="col-sm-9">@(Model.Platform?.Name ?? "未指定")</dd>
                    @if (Model.IssuedAt.HasValue)
                    {
                        <dt class="col-sm-3">開立時間</dt>
                        <dd class="col-sm-9">@Model.IssuedAt.Value.ToString("yyyy/MM/dd HH:mm")</dd>
                    }
                    @if (Model.VoidAt.HasValue)
                    {
                        <dt class="col-sm-3">作廢時間</dt>
                        <dd class="col-sm-9">@Model.VoidAt.Value.ToString("yyyy/MM/dd HH:mm")</dd>
                        <dt class="col-sm-3">作廢原因</dt>
                        <dd class="col-sm-9">@Model.VoidReason</dd>
                    }
                </dl>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">折讓明細</div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>品名</th>
                            <th class="text-end">數量</th>
                            <th class="text-end">單價</th>
                            <th class="text-end">小計</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var it in Model.Items)
                        {
                            <tr>
                                <td>@it.Description</td>
                                <td class="text-end">@it.Quantity</td>
                                <td class="text-end">@it.UnitPrice.ToString("N0")</td>
                                <td class="text-end"><strong>@it.Subtotal.ToString("N0")</strong></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="3" class="text-end"><strong>未稅</strong></td>
                            <td class="text-end"><strong>@Model.Amount.ToString("N0")</strong></td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end">稅額</td>
                            <td class="text-end">@Model.TaxAmount.ToString("N0")</td>
                        </tr>
                        <tr class="table-primary">
                            <td colspan="3" class="text-end"><strong>含稅總計</strong></td>
                            <td class="text-end"><strong>@Model.TotalAmount.ToString("N0")</strong></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">操作</div>
            <div class="card-body">
                @if (Model.Status == "draft")
                {
                    <form asp-action="IssueAllowance" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-success w-100" onclick="return confirm('確定要開立此折讓單嗎？')">確認開立折讓</button>
                    </form>
                }
                @if (Model.Status == "issued")
                {
                    <form asp-action="VoidAllowance" asp-route-id="@Model.Id" method="post">
                        <div class="mb-2">
                            <input type="text" name="voidReason" class="form-control" placeholder="作廢原因" required />
                        </div>
                        <button type="submit" class="btn btn-danger w-100" onclick="return confirm('確定要作廢此折讓嗎？')">作廢折讓</button>
                    </form>
                }
                @if (Model.Status == "void")
                {
                    <p class="text-muted mb-0">此折讓已作廢</p>
                }
            </div>
        </div>
    </div>
</div>
