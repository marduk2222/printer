@{
    var billing = ViewBag.BillingInvoice as printer.Data.Entities.Invoice;
    var activePlatform = ViewBag.ActivePlatform as printer.Data.Entities.EinvoicePlatform;
    ViewData["Title"] = billing != null ? $"從帳單開立發票 - {billing.InvoiceNumber}" : "開立發票";
}

<form asp-action="Create" method="post" id="createForm">
    @if (billing != null)
    {
        <input type="hidden" name="billingInvoiceId" value="@billing.Id" />
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>@ViewData["Title"]</h4>
        <div class="d-flex gap-2">
            @if (activePlatform != null)
            {
                <button type="submit" name="action" value="issue" class="btn btn-primary btn-sm"
                        title="立即送出至 @activePlatform.Name 取得發票號碼">
                    建立並立即開立（@activePlatform.Name）
                </button>
            }
            <button type="submit" name="action" value="draft" class="btn btn-outline-success btn-sm">儲存草稿</button>
            @if (billing != null)
            {
                <a asp-controller="Invoice" asp-action="Details" asp-route-id="@billing.Id" class="btn btn-outline-secondary btn-sm">取消</a>
            }
            else
            {
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">取消</a>
            }
        </div>
    </div>

    @if (activePlatform == null)
    {
        <div class="alert alert-warning small">
            尚未啟用任何發票平台，僅能儲存為草稿。請先到「發票平台設定」啟用一家。
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (billing != null)
    {
        <div class="card mb-3">
            <div class="card-header">來源帳單</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-2">帳單編號</dt>
                    <dd class="col-sm-4"><strong>@billing.InvoiceNumber</strong></dd>
                    <dt class="col-sm-2">客戶</dt>
                    <dd class="col-sm-4">@billing.Partner?.Name</dd>
                    <dt class="col-sm-2">期間</dt>
                    <dd class="col-sm-4">@billing.PeriodStart.ToString("yyyy/MM/dd") ~ @billing.PeriodEnd.ToString("yyyy/MM/dd")</dd>
                    <dt class="col-sm-2">帳單金額</dt>
                    <dd class="col-sm-4"><strong>$@billing.GrandTotal.ToString("N0")</strong></dd>
                </dl>
            </div>
        </div>
    }

    <div class="card mb-3">
        <div class="card-header">發票資訊</div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label">客戶 <span class="text-danger">*</span></label>
                    @if (billing != null)
                    {
                        <input type="hidden" name="partnerId" value="@billing.PartnerId" />
                        <input type="text" class="form-control" value="@billing.Partner?.Name" readonly />
                    }
                    else
                    {
                        <select name="partnerId" id="partnerId" class="form-select ts-select" required>
                            <option value="">請選擇</option>
                            @foreach (SelectListItem item in ViewBag.Partners)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    }
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">發票平台</label>
                    @if (activePlatform != null)
                    {
                        <input type="hidden" name="platformId" value="@activePlatform.Id" />
                        <input type="text" class="form-control" value="@activePlatform.Name" readonly />
                    }
                    else
                    {
                        <select name="platformId" class="form-select">
                            <option value="">不指定</option>
                            @foreach (SelectListItem item in (ViewBag.Platforms as IEnumerable<SelectListItem>) ?? Enumerable.Empty<SelectListItem>())
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    }
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">發票日期 <span class="text-danger">*</span></label>
                    <input type="date" name="invoiceDate" class="form-control" value="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label d-block">發票對象</label>
                    <div class="btn-group w-100" role="group">
                        <input type="radio" class="btn-check" name="invoiceType" id="invType_B2C" value="B2C" checked />
                        <label class="btn btn-outline-primary" for="invType_B2C">B2C 消費者</label>
                        <input type="radio" class="btn-check" name="invoiceType" id="invType_B2B" value="B2B" />
                        <label class="btn btn-outline-primary" for="invType_B2B">B2B 營業人</label>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-2 mb-3">
                    <label class="form-label">課稅類別</label>
                    <select name="taxType" id="taxType" class="form-select">
                        <option value="taxable">應稅</option>
                        <option value="zero">零稅率</option>
                        <option value="free">免稅</option>
                    </select>
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">稅率 (%)</label>
                    <input type="number" name="taxRate" id="taxRate" class="form-control" value="5" min="0" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label d-block">金額輸入方式</label>
                    <div class="btn-group w-100" role="group">
                        <input type="radio" class="btn-check" name="taxIncluded" id="taxOut" value="false" checked />
                        <label class="btn btn-outline-secondary" for="taxOut">稅外加</label>
                        <input type="radio" class="btn-check" name="taxIncluded" id="taxIn" value="true" />
                        <label class="btn btn-outline-secondary" for="taxIn">稅內含</label>
                    </div>
                    <small class="text-muted d-block">「稅內含」=明細為含稅，建立時自動拆稅</small>
                </div>
                <div class="col-md-5 mb-3">
                    <label class="form-label">備註</label>
                    <input type="text" name="note" id="note" class="form-control"
                           value="@(billing != null ? $"帳單 {billing.InvoiceNumber}" : "")" />
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">買方資訊</div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">買方名稱</label>
                    <input type="text" name="buyerName" id="buyerName" class="form-control"
                           value="@(billing?.Partner?.InvoiceTitle ?? billing?.Partner?.Name)" placeholder="自動帶入客戶名稱" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">買方統編</label>
                    <input type="text" name="buyerTaxId" id="buyerTaxId" class="form-control"
                           value="@(billing?.Partner?.InvoiceTaxId ?? billing?.Partner?.Vat)" placeholder="B2B 必填" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">買方 Email</label>
                    <input type="email" name="buyerEmail" id="buyerEmail" class="form-control"
                           value="@(billing?.Partner?.InvoiceEmail ?? billing?.Partner?.Email)" placeholder="發票寄送 Email" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label">載具類型</label>
                    <select name="carrierType" id="carrierType" class="form-select">
                        <option value="">紙本</option>
                        <option value="mobile">手機條碼</option>
                        <option value="citizen">自然人憑證</option>
                        <option value="donate">捐贈</option>
                    </select>
                </div>
                <div class="col-md-5 mb-3">
                    <label class="form-label">載具號碼</label>
                    <input type="text" name="carrierId" id="carrierId" class="form-control" placeholder="如 /AB+12.3" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">愛心碼 (捐贈用)</label>
                    <input type="text" name="donationCode" id="donationCode" class="form-control" placeholder="3-7 位數字" />
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>發票明細</span>
            <button type="button" class="btn btn-sm btn-primary" id="addItemBtn">新增明細</button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>品名</th>
                            <th class="text-end" style="width:100px">數量</th>
                            <th class="text-end" style="width:120px">單價</th>
                            <th class="text-end" style="width:120px">小計</th>
                            <th style="width:50px"></th>
                        </tr>
                    </thead>
                    <tbody id="itemsBody"></tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="3" class="text-end"><strong>未稅合計</strong></td>
                            <td class="text-end"><strong id="totalAmount">0</strong></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end">稅額</td>
                            <td class="text-end" id="taxAmount">0</td>
                            <td></td>
                        </tr>
                        <tr class="table-primary">
                            <td colspan="3" class="text-end"><strong>含稅總計</strong></td>
                            <td class="text-end"><strong id="grandTotal">0</strong></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div id="emptyMessage" class="text-center py-4 text-muted" style="display:none">
                <p class="mb-0">請新增明細</p>
            </div>
        </div>
    </div>

</form>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const addItemBtn = document.getElementById('addItemBtn');
        const itemsBody = document.getElementById('itemsBody');
        const emptyMessage = document.getElementById('emptyMessage');
        const totalAmountEl = document.getElementById('totalAmount');
        const taxAmountEl = document.getElementById('taxAmount');
        const grandTotalEl = document.getElementById('grandTotal');
        const taxTypeSelect = document.getElementById('taxType');
        const taxRateInput = document.getElementById('taxRate');
        const partnerSelect = document.getElementById('partnerId');
        let itemIndex = 0;

        addItemBtn.addEventListener('click', () => addItem());
        taxTypeSelect.addEventListener('change', updateTotal);
        taxRateInput.addEventListener('input', updateTotal);
        document.querySelectorAll('input[name="taxIncluded"]').forEach(r => r.addEventListener('change', updateTotal));

        // 從帳單帶入明細
        const billingItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            billing?.Items.Select(i => new { desc = (i.Printer?.Name ?? "") + " " + i.Description, subtotal = i.Subtotal }).ToList()
            ?? (object)new List<object>()));
        if (billingItems.length > 0) {
            billingItems.forEach(bi => addItem(bi.desc, 1, bi.subtotal));
        } else {
            emptyMessage.style.display = '';
        }

        // 客戶切換 → AJAX 帶入 Partner info（僅在非帳單模式啟用）
        if (partnerSelect) {
            partnerSelect.addEventListener('change', function () {
                const id = partnerSelect.value;
                if (!id) return;
                fetch('@Url.Action("GetInvoiceInfo", "Partner")?id=' + encodeURIComponent(id))
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (d) {
                        if (!d) return;
                        document.getElementById('buyerTaxId').value = d.buyerTaxId || '';
                        document.getElementById('buyerName').value = d.buyerName || '';
                        document.getElementById('buyerEmail').value = d.buyerEmail || '';
                        document.getElementById('carrierType').value = d.carrierType || '';
                        document.getElementById('carrierId').value = d.carrierId || '';
                        document.getElementById('donationCode').value = d.donationCode || '';
                        // 不自動覆寫 taxType：若客戶切換在使用者選好稅別之後發生，
                        // 會覆蓋使用者意圖（曾發生 0 稅率被改回應稅的問題）。改由使用者明確選擇。
                        document.getElementById('note').value = d.note || '';
                    })
                    .catch(function () { /* ignore */ });
            });
        }

        function addItem(desc, qty, price) {
            emptyMessage.style.display = 'none';
            const idx = itemIndex++;
            const tr = document.createElement('tr');

            tr.innerHTML = `
                <td><input name="items[${idx}].Description" class="form-control form-control-sm" value="${desc || ''}" placeholder="品名" required /></td>
                <td><input name="items[${idx}].Quantity" type="number" class="form-control form-control-sm text-end item-qty" min="1" value="${qty || 1}" /></td>
                <td><input name="items[${idx}].UnitPrice" type="number" class="form-control form-control-sm text-end item-price" min="0" step="1" value="${Math.round(price || 0)}" /></td>
                <td><input name="items[${idx}].Subtotal" type="number" class="form-control form-control-sm text-end item-subtotal" min="0" step="1" value="${Math.round((qty || 1) * (price || 0))}" readonly /></td>
                <td><button type="button" class="btn btn-sm btn-outline-danger remove-item">X</button></td>
            `;

            const qtyInput = tr.querySelector('.item-qty');
            const priceInput = tr.querySelector('.item-price');
            const subtotalInput = tr.querySelector('.item-subtotal');

            function calcRow() {
                subtotalInput.value = Math.round((parseInt(qtyInput.value) || 0) * (parseInt(priceInput.value) || 0));
                updateTotal();
            }

            qtyInput.addEventListener('input', calcRow);
            priceInput.addEventListener('input', calcRow);

            tr.querySelector('.remove-item').addEventListener('click', function () {
                tr.remove();
                updateTotal();
                if (itemsBody.children.length === 0) emptyMessage.style.display = '';
            });

            itemsBody.appendChild(tr);
            updateTotal();
        }

        function updateTotal() {
            let sum = 0;
            document.querySelectorAll('.item-subtotal').forEach(el => { sum += parseFloat(el.value) || 0; });
            const rate = parseInt(taxRateInput.value) || 0;
            const taxable = taxTypeSelect.value === 'taxable';
            const included = document.querySelector('input[name="taxIncluded"]:checked')?.value === 'true';

            let untaxed, tax, grand;
            if (!taxable) {
                untaxed = sum; tax = 0; grand = sum;
            } else if (included) {
                untaxed = Math.round(sum / (1 + rate / 100));
                tax = sum - untaxed;
                grand = sum;
            } else {
                untaxed = sum;
                tax = Math.round(sum * rate / 100);
                grand = sum + tax;
            }
            totalAmountEl.textContent = untaxed.toLocaleString('zh-TW');
            taxAmountEl.textContent = tax.toLocaleString('zh-TW');
            grandTotalEl.textContent = grand.toLocaleString('zh-TW');
        }
    });
</script>
}
